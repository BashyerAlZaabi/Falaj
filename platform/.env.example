# ---------- Portal (Unified Portal + ADAA I + Ask AI + MCP) ----------
PORT=4000
PUBLIC_URL=http://localhost:4000
# DATA_DIR=./data                 # portal.db, identity keys, vault/ (separate DB)
# COOKIE_SECURE=1                 # set behind HTTPS
# SESSION_HOURS=12

# ---------- AI Services (keys stay on the server; referenced by name in the admin UI) ----------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
# LLM_GATEWAY_URL=https://your-gateway/v1   # any OpenAI-compatible endpoint
# LLM_GATEWAY_MODEL=enterprise-model
# LLM_GATEWAY_KEY=...

# ---------- Vault (separate process/origin) ----------
VAULT_PORT=4100
VAULT_PUBLIC_URL=http://localhost:4100
VAULT_INGEST_URL=http://localhost:4100/ingest/su/marsad
IDENTITY_URL=http://localhost:4000
# IDENTITY_PUBLIC_KEY_PATH=./data/identity-keys/identity-ed25519.pub.pem
# Inbound-only service credentials (generated automatically by `npm run dev` if missing)
# SU_SERVICE_TOKEN=
# WAJIB_FS_TOKEN=
# WAJIB_MARSAD_TOKEN=
# Vault-internal model (optional). Only this host is allowed out of Vault.
# VAULT_AI_URL=http://127.0.0.1:11434
# VAULT_AI_MODEL=local
# VAULT_EGRESS_ALLOW=

# ---------- PDF ----------
# CHROMIUM_PATH=/usr/bin/chromium   # otherwise LibreOffice (soffice) is used if installed
