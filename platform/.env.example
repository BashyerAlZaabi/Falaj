# ---------- Portal (Unified Portal + ADAA I + Ask AI + MCP) ----------
PORT=4000
PUBLIC_URL=http://localhost:4000
# DATA_DIR=./data                 # portal.db, identity keys, vault/ (separate DB)
# COOKIE_SECURE=1                 # set behind HTTPS
# SESSION_HOURS=12

# ---------- AI Services (keys stay on the server; referenced by name in the admin UI) ----------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_THINKING=adaptive           # 'off' disables adaptive thinking
# ANTHROPIC_EFFORT=                      # optional: low | medium | high
# ANTHROPIC_TIMEOUT_MS=120000
# LLM_GATEWAY_URL=https://your-gateway/v1   # any OpenAI-compatible endpoint
# LLM_GATEWAY_MODEL=enterprise-model
# LLM_GATEWAY_KEY=...

# ---------- Vault (separate process/origin) ----------
VAULT_PORT=4100
VAULT_PUBLIC_URL=http://localhost:4100
VAULT_INGEST_URL=http://localhost:4100/ingest/su/marsad
IDENTITY_URL=http://localhost:4000
# IDENTITY_PUBLIC_KEY_PATH=./data/identity-keys/identity-ed25519.pub.pem
# Inbound-only service credentials (generated automatically by `npm run dev` if missing)
# SU_SERVICE_TOKEN=
# WAJIB_FS_TOKEN=
# WAJIB_MARSAD_TOKEN=
# Vault-internal model (optional). Only this host is allowed out of Vault.
# VAULT_AI_URL=http://127.0.0.1:11434
# VAULT_AI_MODEL=local
# VAULT_EGRESS_ALLOW=

# ---------- PDF ----------
# CHROMIUM_PATH=/usr/bin/chromium   # otherwise LibreOffice (soffice) is used if installed

# ---------- Production / Docker (docker-compose.yml) ----------
# NODE_ENV=production                    # the servers REFUSE to start with unsafe settings
# PORTAL_DOMAIN=portal.example.gov.ae
# VAULT_DOMAIN=vault.example.gov.ae
# SEED_DEMO=0                            # required in production
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=                        # first admin account (SEED_DEMO=0)
# TRUST_PROXY=1                          # hops of reverse proxy in front of the app
# LOG_FORMAT=json                        # one JSON object per log line
# ACCESS_LOG=1                           # request log: method, path, status, ms, user id (no bodies)
# RATE_LIMIT_PER_MIN=1200                # per client IP on /api (RATE_LIMIT=0 disables all limits)
# AI_RATE_LIMIT_PER_MIN=40               # per user on /api/chat and voice
# MCP_RATE_LIMIT_PER_MIN=300
# BACKUP_INTERVAL_HOURS=24               # VACUUM INTO snapshots; 0 = off (use `npm run backup`)
# BACKUP_KEEP=14
# BACKUP_DIR=/data/backups
# IDENTITY_PUBLIC_EXPORT_DIR=            # publishes ONLY the SSO public key for a separate Vault container
