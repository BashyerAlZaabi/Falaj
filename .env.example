# ============================================================
# متغيّرات البيئة — انسخ هذا الملف إلى .env.local واملأ القيم
# لا تضع أي مفتاح سرّي في كود العميل. مفتاح Anthropic خادمي حصراً.
# ============================================================

# Supabase — من لوحة المشروع: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic — يُستخدم داخل Route Handler فقط (المرحلة ٣)، لا بادئة NEXT_PUBLIC
ANTHROPIC_API_KEY=
