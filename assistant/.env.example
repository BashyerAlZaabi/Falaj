# Required — your Claude API key (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optional
# FALAJ_MODEL=claude-opus-5
# FALAJ_EFFORT=medium          # low | medium | high | xhigh | max
# FALAJ_FALLBACKS=off          # turn off server-side refusal fallback (needed on Bedrock/Vertex/Foundry)
# PORT=8787
# ALLOWED_ORIGINS=https://bashyeralzaabi.github.io
# RATE_LIMIT_PER_MIN=20
# MCP_CONFIG=./mcp.config.json   # or mcp.audit.json for the audit-firm assistant
# TOOL_LOG_FILE=./tool-calls.jsonl  # append-only audit trail of every tool call

# ---------- Audit-firm assistant (npm run start:audit) ----------
# AUDIT_DATA_DIR=./data                 # shared audit store + imports folder
# AUDIT_IMPORT_DIR=./data/imports       # where client extracts / timesheets are read from
# AUDIT_ERP_CONNECTIONS=./erp.connections.json   # per-engagement ERP connections (see erp.connections.example.json)
# AUDIT_TODAY=2026-09-23                # pin "today" for demos

# Microsoft 365 (Outlook, calendar, SharePoint/OneDrive) via Microsoft Graph — leave empty for the demo mailbox.
# App-only (production): Entra ID app with Mail.ReadWrite, Calendars.ReadWrite, Files.ReadWrite.All (or Sites.Selected)
# M365_TENANT_ID=
# M365_CLIENT_ID=
# M365_CLIENT_SECRET=
# M365_MAILBOX=audit.manager@yourfirm.com
# M365_SHAREPOINT_SITE=yourfirm.sharepoint.com:/sites/Audit
# M365_TIMEZONE=Arabian Standard Time
# Or, for a quick test, a delegated token from Graph Explorer (expires in ~1h):
# M365_ACCESS_TOKEN=

# ERP secrets referenced from erp.connections.json as ${NAME}
# GULF_TRADING_ODOO_KEY=
# ALNOOR_BC_CLIENT_SECRET=
