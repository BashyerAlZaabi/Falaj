# Required — your Claude API key (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optional
# FALAJ_MODEL=claude-opus-5
# FALAJ_EFFORT=medium          # low | medium | high | xhigh | max
# FALAJ_FALLBACKS=off          # turn off server-side refusal fallback (needed on Bedrock/Vertex/Foundry)
# PORT=8787
# ALLOWED_ORIGINS=https://bashyeralzaabi.github.io
# RATE_LIMIT_PER_MIN=20
# MCP_CONFIG=./mcp.config.json   # or mcp.audit.json for the audit-firm assistant
# TOOL_LOG_FILE=./tool-calls.jsonl  # append-only audit trail of every tool call
