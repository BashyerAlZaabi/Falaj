# FALAJ — environment configuration
# Copy this file to `.env` and fill in values. Do NOT commit your real `.env`.
# All client-exposed values must be prefixed with VITE_ (Vite only exposes those).

# App identity
VITE_APP_ID=
VITE_APP_TITLE=FALAJ - Smart Agriculture

# OAuth portal (sign-in). Leave blank to run without authentication.
VITE_OAUTH_PORTAL_URL=

# Optional analytics (umami). Leave blank to disable.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Server
PORT=3000
